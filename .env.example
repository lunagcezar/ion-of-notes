# The owner password is provided by `secrets/owner_password.txt` as a Docker
# secret. Copy `secrets/owner_password.txt.example` to that path and set a
# strong value before the first run.
#
# For `docker run` or a local `--serve`, `ION_OF_NOTES_OWNER_PASSWORD` remains
# the fallback environment variable.

# Optional bind address, host port and tracing filter.
# Keep 127.0.0.1 unless a trusted reverse proxy or LAN access needs otherwise.
# ION_OF_NOTES_BIND=127.0.0.1
# ION_OF_NOTES_PORT=8787
# RUST_LOG=info,tower_http=info
