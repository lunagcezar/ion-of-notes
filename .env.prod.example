# Copy to `.env.prod` and set the public hostname. DNS must point at this host
# and ports 80/443 must be reachable.
ION_OF_NOTES_DOMAIN=notes.example.com

# Optional: use a prebuilt image instead of building locally.
# ION_OF_NOTES_IMAGE=registry.example/ion-of-notes-server:1.0.0

# Optional: Caddyfile path (use ./deploy/Caddyfile.local for a local TLS test).
# ION_OF_NOTES_CADDYFILE=./deploy/Caddyfile

# Optional: daily SQLite backup retention (profile `backup`).
# ION_OF_NOTES_BACKUP_RETENTION_DAYS=7

# Optional: tracing filter.
# RUST_LOG=info,tower_http=info
